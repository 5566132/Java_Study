<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.mp.mapper.UserMapper">
    <sql id = "AllSegment">
        id, t_name, age, salary , address , createTime
    </sql>



    <select id="selectAllUser" resultType="user">
        select * from tb_user
    </select>


    <select id="selectUserByWrapper" resultMap="UserMP">
        select <include refid="AllSegment"></include> from tb_user ${ew.customSqlSegment}
    </select>

    <resultMap id="UserMP" type="com.itheima.mp.domain.po.User">
        <id column="id" property="id"></id>
        <result column="t_name" property="name"></result>
        <result column="age" property="age"></result>
        <result column="salary" property="salary"></result>
        <result column="address" property="address"></result>
        <result column="create_time" property="createTime"></result>
    </resultMap>

<!--    根据id扣money-->
    <update id="DeductMoneyById" >
        update tb_user set salary = salary - #{money} where id = #{id}
    </update>



</mapper>
