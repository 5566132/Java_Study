<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.Project.blog.mapper.CommentMapper">
<!--    全字段sql-->
    <sql id="CommentAll">
        id, context, user_id, article_id
    </sql>

    <!--    需要一个中间的查询user信息的sql-->
    <resultMap id="VoCommentMPs" type="com.Project.blog.Bean.Vo.Comment.VoComment">
        <id column="id" property="id"></id>
        <result column="context" property="context"></result>
        <association property="voUser"
                     select="com.Project.blog.mapper.UserMapper.selectVoUserById"
                     column="user_id">
        </association>
    </resultMap>
    <!--    resultMap="com.Project.blog.mapper.UserMapper.VoUserMP"-->

    <resultMap id="VoCommentMP" type="com.Project.blog.Bean.Vo.Comment.VoComment">
        <id column="c_id" property="id"></id>
        <result column="c_context" property="context"></result>
        <association property="voUser" javaType="com.Project.blog.Bean.Vo.User.VoUser">
            <result column="u_id" property="id"></result>
            <result column="u_name" property="name"></result>
        </association>


    </resultMap>


<!--    我直接在这里封装一个多sql查询直接给VoComment中的VoUser注入了-->
    <select id="selectCommentByArticleId" resultMap="VoCommentMPs">
        select <include refid="CommentAll"></include> from tb_comment where article_id = #{id}
    </select>

<!--    根据评论查用户, 我直接补充一个left join去解决N + 1问题-->
    <select id="selectCommentsByArticleId" resultMap="VoCommentMP">
        select c.id c_id , c.context c_context,  u.id  u_id, u.name u_name
                from tb_comment c left join tb_user u on c.user_id = u.id
                where c.article_id = #{articleId}
    </select>





</mapper>
