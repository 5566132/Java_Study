<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.Project.blog.mapper.UserMapper">

<!--    这个是用于映射User这个类的-->
    <resultMap id="UserMP" type="com.Project.blog.Bean.Po.User">
        <id column="id" property="id"></id>
        <result column="name" property="name"></result>
        <result column="password" property="password"></result>
    </resultMap>

    <!--    用于映射VoUser这个类-->
    <resultMap id="VoUserMP" type="com.Project.blog.Bean.Vo.User.VoUser">
        <id column="id" property="id"></id>
        <result column="name" property="name"></result>
    </resultMap>





<!--    -->
<!--&lt;!&ndash; 利用Comment的user_id字段去查询匹配的VoUser&ndash;&gt;-->
<!--    <select id="selectVoUserByCommentuserId" resultMap="VoUserMP">-->
<!--        select id, name from tb_user where id = #{commentUserId}-->
<!--    </select>-->
<!--    -->

<!--    姓名模糊匹配User, 并实现分页功能-->
    <select id="selectVoUserByName_OnPage" resultMap="VoUserMP">
        select id, name from tb_user
            where name like concat('%',#{keyword},'%')
            order by id
            limit  #{offset}, #{size}
    </select>

<!--    根据用户的id直接返回简单用户视图VoUser-->
    <select id="selectVoUserById" resultMap="VoUserMP">
        select id , name from tb_user where id = #{id}
    </select>




</mapper>

